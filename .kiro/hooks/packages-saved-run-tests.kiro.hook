{
  "enabled": true,
  "name": "Package code saved: run all tests",
  "description": "When a file under packages/ is saved, run the full test suite.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "packages/**/*.js",
      "packages/**/*.json"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm test"
  }
}
