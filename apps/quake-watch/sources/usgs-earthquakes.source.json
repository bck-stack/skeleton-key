{
  "$schema": "../../../packages/core/schema/source.schema.json",
  "source": "usgs-earthquakes",
  "tool": {
    "name": "quakes_near",
    "description": "Returns earthquakes within a radius of a point (id, time in UTC, magnitude, place, latitude, longitude, depth in km, USGS page), newest first, at most 'limit' records. start_date is a UTC calendar date. Use when asked which earthquakes happened near a place or coordinates since a date. An empty list means no matching earthquakes. Do not use for forecasts or for anything but past earthquakes."
  },
  "params": {
    "latitude": {
      "type": "number",
      "required": true,
      "minimum": -90,
      "maximum": 90,
      "description": "Latitude of the search center in decimal degrees, -90 to 90 (north is positive).",
      "example": 38.2
    },
    "longitude": {
      "type": "number",
      "required": true,
      "minimum": -180,
      "maximum": 180,
      "description": "Longitude of the search center in decimal degrees, -180 to 180 (east is positive).",
      "example": 37.2
    },
    "radius_km": {
      "type": "number",
      "default": 300,
      "minimum": 1,
      "maximum": 1000,
      "description": "Search radius in kilometers, 1 to 1000.",
      "example": 300
    },
    "start_date": {
      "type": "date",
      "required": true,
      "description": "Earliest event date, YYYY-MM-DD, a UTC calendar date, inclusive.",
      "example": "2026-09-01"
    },
    "min_magnitude": {
      "type": "number",
      "default": 2.5,
      "minimum": 0,
      "maximum": 10,
      "description": "Smallest magnitude to return, 0 to 10.",
      "example": 2.5
    },
    "limit": {
      "type": "integer",
      "default": 200,
      "minimum": 1,
      "maximum": 500,
      "description": "Maximum number of events to return, 1 to 500.",
      "example": 200
    }
  },
  "request": {
    "baseUrl": "https://earthquake.usgs.gov/fdsnws/event/1/query",
    "staticQuery": {
      "format": "geojson",
      "eventtype": "earthquake",
      "orderby": "time"
    },
    "query": [
      {
        "key": "latitude",
        "template": "{latitude}"
      },
      {
        "key": "longitude",
        "template": "{longitude}"
      },
      {
        "key": "maxradiuskm",
        "template": "{radius_km}"
      },
      {
        "key": "starttime",
        "template": "{start_date}"
      },
      {
        "key": "minmagnitude",
        "template": "{min_magnitude}"
      },
      {
        "key": "limit",
        "template": "{limit}"
      }
    ],
    "timeoutMs": 10000,
    "cacheSeconds": 60
  },
  "response": {
    "recordsPath": "features",
    "fields": {
      "id": {
        "from": "id",
        "transform": [
          "trim"
        ],
        "type": "string",
        "required": true,
        "description": "USGS event id."
      },
      "time": {
        "from": "properties.time",
        "transform": [
          "epochMsToIso"
        ],
        "type": "string",
        "required": true,
        "description": "Origin time, ISO 8601 UTC."
      },
      "magnitude": {
        "from": "properties.mag",
        "transform": [
          "toNumber"
        ],
        "type": "number",
        "description": "Magnitude. Null when USGS has none."
      },
      "place": {
        "from": "properties.place",
        "transform": [
          "trim"
        ],
        "type": "string",
        "description": "USGS place text, for example '21 km E of Feke, Turkey'."
      },
      "latitude": {
        "from": "geometry.coordinates.1",
        "transform": [
          "toNumber"
        ],
        "type": "number",
        "required": true,
        "description": "Epicenter latitude in degrees."
      },
      "longitude": {
        "from": "geometry.coordinates.0",
        "transform": [
          "toNumber"
        ],
        "type": "number",
        "required": true,
        "description": "Epicenter longitude in degrees."
      },
      "depth_km": {
        "from": "geometry.coordinates.2",
        "transform": [
          "toNumber"
        ],
        "type": "number",
        "description": "Depth in kilometers."
      },
      "url": {
        "from": "properties.url",
        "transform": [
          "trim"
        ],
        "type": "string",
        "description": "USGS event page."
      }
    }
  },
  "fixture": {
    "input": {
      "latitude": 38.2,
      "longitude": 37.2,
      "radius_km": 300,
      "start_date": "2026-09-01",
      "min_magnitude": 2.5,
      "limit": 3
    },
    "expectedUrl": "https://earthquake.usgs.gov/fdsnws/event/1/query?eventtype=earthquake&format=geojson&orderby=time&latitude=38.2&longitude=37.2&maxradiuskm=300&starttime=2026-09-01&minmagnitude=2.5&limit=3",
